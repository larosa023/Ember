<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ember.ViewModels"
             x:Class="Ember.Views.SensorsView"
             x:DataType="vm:SensorsViewModel">

  <ScrollViewer>
    <StackPanel Spacing="18">
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="Sensors" />
        <TextBlock Classes="label" Text="{Binding Summary}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="16" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SensorGroup">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="{Binding Name}" />
                <Grid ColumnDefinitions="*,110,110,110">
                  <TextBlock Grid.Column="0" Classes="eyebrow" Text="SENSOR" />
                  <TextBlock Grid.Column="1" Classes="eyebrow" Text="NOW" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Classes="eyebrow" Text="MIN" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Classes="eyebrow" Text="MAX" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SensorRow">
                      <Grid ColumnDefinitions="*,110,110,110" Margin="0,5">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Classes="label" Text="{Binding Type}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Classes="label" Text="{Binding Min}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Classes="label" Text="{Binding Max}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
