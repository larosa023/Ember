<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ember.ViewModels"
             xmlns:c="using:Ember.Controls"
             x:Class="Ember.Views.ProcessesView"
             x:DataType="vm:ProcessesViewModel">

  <!-- Column widths come from ColumnLayout.Instance (shared by header and every row).
       Header cells are separated by 9px ColumnResizer dividers; rows use Spacing="9" to line up. -->

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Classes="pageheader">
      <TextBlock Classes="h1" Text="Processes" />
      <TextBlock Classes="subtitle" Text="{Binding Summary}" />
    </StackPanel>

    <!-- Toolbar: search left, actions right -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Classes="ghost" Command="{Binding OpenLocationCommand}" ToolTip.Tip="Open file location">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" FontSize="13" Text="&#xE838;" />
            <TextBlock Text="Open location" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding EndTreeCommand}" ToolTip.Tip="End this process and everything it started">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" FontSize="13" Text="&#xE8EC;" />
            <TextBlock Text="End tree" />
          </StackPanel>
        </Button>
        <Button Classes="accent" Margin="6,0,0,0" Command="{Binding EndTaskCommand}" ToolTip.Tip="End task (Delete)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" FontSize="13" Text="&#xE711;" />
            <TextBlock Text="End task" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBox Classes="search" Width="320" HorizontalAlignment="Left"
               Watermark="Search name or PID" Text="{Binding Search}">
        <TextBox.InnerLeftContent>
          <TextBlock Classes="icon" FontSize="13" Margin="10,0,2,0" Foreground="{DynamicResource TextMuted}" Text="&#xE721;" />
        </TextBox.InnerLeftContent>
      </TextBox>
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Classes="label" Margin="4,10,0,0" TextWrapping="Wrap" Text="{Binding Status}"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Border Classes="card" Padding="0" ClipToBounds="True">
      <DockPanel>

        <!-- Header: system totals above column names, draggable dividers, right-click for columns -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="54" Margin="16,2,0,0" Background="Transparent">
          <StackPanel.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Columns" IsEnabled="False" />
              <MenuItem Header="Status" Command="{ReflectionBinding ToggleColumnCommand, Source={x:Static vm:ColumnLayout.Instance}}" CommandParameter="status">
                <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{ReflectionBinding ShowStatus, Source={x:Static vm:ColumnLayout.Instance}}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="PID" Command="{ReflectionBinding ToggleColumnCommand, Source={x:Static vm:ColumnLayout.Instance}}" CommandParameter="pid">
                <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{ReflectionBinding ShowPid, Source={x:Static vm:ColumnLayout.Instance}}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="CPU" Command="{ReflectionBinding ToggleColumnCommand, Source={x:Static vm:ColumnLayout.Instance}}" CommandParameter="cpu">
                <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{ReflectionBinding ShowCpu, Source={x:Static vm:ColumnLayout.Instance}}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="GPU" Command="{ReflectionBinding ToggleColumnCommand, Source={x:Static vm:ColumnLayout.Instance}}" CommandParameter="gpu">
                <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{ReflectionBinding ShowGpu, Source={x:Static vm:ColumnLayout.Instance}}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Memory" Command="{ReflectionBinding ToggleColumnCommand, Source={x:Static vm:ColumnLayout.Instance}}" CommandParameter="mem">
                <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{ReflectionBinding ShowMem, Source={x:Static vm:ColumnLayout.Instance}}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Disk" Command="{ReflectionBinding ToggleColumnCommand, Source={x:Static vm:ColumnLayout.Instance}}" CommandParameter="disk">
                <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{ReflectionBinding ShowDisk, Source={x:Static vm:ColumnLayout.Instance}}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Network" Command="{ReflectionBinding ToggleColumnCommand, Source={x:Static vm:ColumnLayout.Instance}}" CommandParameter="net">
                <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{ReflectionBinding ShowNet, Source={x:Static vm:ColumnLayout.Instance}}" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Memory units">
                <MenuItem Header="Automatic (MB or GB)" Command="{Binding SetMemoryUnitCommand}" CommandParameter="auto">
                  <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{Binding MemoryAuto}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Always MB, like Task Manager" Command="{Binding SetMemoryUnitCommand}" CommandParameter="mb">
                  <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{Binding MemoryMb}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Always GB" Command="{Binding SetMemoryUnitCommand}" CommandParameter="gb">
                  <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{Binding MemoryGb}" /></MenuItem.Icon>
                </MenuItem>
              </MenuItem>
            </ContextMenu>
          </StackPanel.ContextMenu>

          <Button Classes="header" HorizontalContentAlignment="Left" VerticalAlignment="Stretch" VerticalContentAlignment="Bottom" Padding="0,0,0,8"
                  Width="{ReflectionBinding NameWidth, Source={x:Static vm:ColumnLayout.Instance}}"
                  Content="{Binding NameHeader}" Command="{Binding SortCommand}" CommandParameter="name"
                  ToolTip.Tip="Click to sort · right-click to choose columns" />
          <c:ColumnResizer Column="name">
            <Border Classes="divider" />
          </c:ColumnResizer>
          <Border Width="{ReflectionBinding StatusWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowStatus, Source={x:Static vm:ColumnLayout.Instance}}" Padding="0,0,0,8">
            <TextBlock Classes="label" FontSize="12" FontWeight="SemiBold" Text="Status" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
          </Border>
          <c:ColumnResizer Column="status" IsVisible="{ReflectionBinding ShowStatus, Source={x:Static vm:ColumnLayout.Instance}}">
            <Border Classes="divider" />
          </c:ColumnResizer>
          <Button Classes="header" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" VerticalContentAlignment="Bottom" Padding="0,0,0,8"
                  Width="{ReflectionBinding PidWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowPid, Source={x:Static vm:ColumnLayout.Instance}}"
                  Content="{Binding PidHeader}" Command="{Binding SortCommand}" CommandParameter="pid" />
          <c:ColumnResizer Column="pid" IsVisible="{ReflectionBinding ShowPid, Source={x:Static vm:ColumnLayout.Instance}}">
            <Border Classes="divider" />
          </c:ColumnResizer>
          <Button Classes="header" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" VerticalContentAlignment="Bottom"
                  Padding="0,0,0,8" Width="{ReflectionBinding CpuWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowCpu, Source={x:Static vm:ColumnLayout.Instance}}"
                  Command="{Binding SortCommand}" CommandParameter="cpu" ToolTip.Tip="Click to sort">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <TextBlock Classes="coltotal" HorizontalAlignment="Right" Text="{Binding TotalCpuText}" />
              <TextBlock HorizontalAlignment="Right" Text="{Binding CpuHeader}" />
            </StackPanel>
          </Button>
          <c:ColumnResizer Column="cpu" IsVisible="{ReflectionBinding ShowCpu, Source={x:Static vm:ColumnLayout.Instance}}">
            <Border Classes="divider" />
          </c:ColumnResizer>
          <Button Classes="header" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" VerticalContentAlignment="Bottom"
                  Padding="0,0,0,8" Width="{ReflectionBinding GpuWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowGpu, Source={x:Static vm:ColumnLayout.Instance}}"
                  Command="{Binding SortCommand}" CommandParameter="gpu" ToolTip.Tip="Click to sort">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <TextBlock Classes="coltotal" HorizontalAlignment="Right" Text="{Binding TotalGpuText}" />
              <TextBlock HorizontalAlignment="Right" Text="{Binding GpuHeader}" />
            </StackPanel>
          </Button>
          <c:ColumnResizer Column="gpu" IsVisible="{ReflectionBinding ShowGpu, Source={x:Static vm:ColumnLayout.Instance}}">
            <Border Classes="divider" />
          </c:ColumnResizer>
          <Button Classes="header" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" VerticalContentAlignment="Bottom"
                  Padding="0,0,0,8" Width="{ReflectionBinding MemWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowMem, Source={x:Static vm:ColumnLayout.Instance}}"
                  Command="{Binding SortCommand}" CommandParameter="mem" ToolTip.Tip="Click to sort · right-click for units">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <TextBlock Classes="coltotal" HorizontalAlignment="Right" Text="{Binding TotalMemText}" />
              <TextBlock HorizontalAlignment="Right" Text="{Binding MemoryHeader}" />
            </StackPanel>
          </Button>
          <c:ColumnResizer Column="mem" IsVisible="{ReflectionBinding ShowMem, Source={x:Static vm:ColumnLayout.Instance}}">
            <Border Classes="divider" />
          </c:ColumnResizer>
          <Button Classes="header" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" VerticalContentAlignment="Bottom"
                  Padding="0,0,0,8" Width="{ReflectionBinding DiskWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowDisk, Source={x:Static vm:ColumnLayout.Instance}}"
                  Command="{Binding SortCommand}" CommandParameter="disk" ToolTip.Tip="Click to sort">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <TextBlock Classes="coltotal" HorizontalAlignment="Right" Text="{Binding TotalDiskText}" />
              <TextBlock HorizontalAlignment="Right" Text="{Binding DiskHeader}" />
            </StackPanel>
          </Button>
          <c:ColumnResizer Column="disk" IsVisible="{ReflectionBinding ShowDisk, Source={x:Static vm:ColumnLayout.Instance}}">
            <Border Classes="divider" />
          </c:ColumnResizer>
          <Button Classes="header" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" VerticalContentAlignment="Bottom"
                  Padding="0,0,0,8" Width="{ReflectionBinding NetWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowNet, Source={x:Static vm:ColumnLayout.Instance}}"
                  Command="{Binding SortCommand}" CommandParameter="net" ToolTip.Tip="{Binding NetTip}">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <TextBlock Classes="coltotal" HorizontalAlignment="Right" Text="{Binding TotalNetText}" />
              <TextBlock HorizontalAlignment="Right" Text="{Binding NetHeader}" />
            </StackPanel>
          </Button>
          <c:ColumnResizer Column="net" IsVisible="{ReflectionBinding ShowNet, Source={x:Static vm:ColumnLayout.Instance}}">
            <Border Classes="divider" />
          </c:ColumnResizer>
        </StackPanel>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Stroke}" />

        <ListBox Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
          <ListBox.KeyBindings>
            <KeyBinding Gesture="Delete" Command="{Binding EndTaskCommand}" />
          </ListBox.KeyBindings>

          <ListBox.ContextMenu>
        <ContextMenu Opening="OnMenuOpening">
          <MenuItem Header="End task" Command="{Binding EndTaskCommand}" InputGesture="Delete">
            <MenuItem.Icon><TextBlock Classes="icon" FontSize="13" Text="&#xE711;" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="End process tree" Command="{Binding EndTreeCommand}">
            <MenuItem.Icon><TextBlock Classes="icon" FontSize="13" Text="&#xE8EC;" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Priority">
            <MenuItem.Icon><TextBlock Classes="icon" FontSize="13" Text="&#xE9D9;" /></MenuItem.Icon>
            <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="high">
              <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{Binding PriorityHigh}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Above normal" Command="{Binding SetPriorityCommand}" CommandParameter="above">
              <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{Binding PriorityAboveNormal}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="normal">
              <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{Binding PriorityNormal}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Below normal" Command="{Binding SetPriorityCommand}" CommandParameter="below">
              <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{Binding PriorityBelowNormal}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Low" Command="{Binding SetPriorityCommand}" CommandParameter="low">
              <MenuItem.Icon><TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{Binding PriorityLow}" /></MenuItem.Icon>
            </MenuItem>
          </MenuItem>
          <MenuItem Header="Efficiency mode" Command="{Binding ToggleEfficiencyCommand}">
            <MenuItem.Icon>
              <Panel>
                <TextBlock Classes="icon" FontSize="13" Text="&#xEC0A;" IsVisible="{Binding !MenuEfficiency}" />
                <TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" IsVisible="{Binding MenuEfficiency}" />
              </Panel>
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Open file location" Command="{Binding OpenLocationCommand}">
            <MenuItem.Icon><TextBlock Classes="icon" FontSize="13" Text="&#xE838;" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Search online" Command="{Binding SearchOnlineCommand}">
            <MenuItem.Icon><TextBlock Classes="icon" FontSize="13" Text="&#xE721;" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}">
            <MenuItem.Icon><TextBlock Classes="icon" FontSize="13" Text="&#xE8C8;" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}">
            <MenuItem.Icon><TextBlock Classes="icon" FontSize="13" Text="&#xE946;" /></MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </ListBox.ContextMenu>


          <ListBox.DataTemplates>

            <!-- Section header: "Apps (5)" -->
            <DataTemplate DataType="vm:SectionRow" x:DataType="vm:SectionRow">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,2">
                <TextBlock Classes="icon" FontSize="10" Foreground="{DynamicResource TextMuted}" Text="{Binding Chevron}" />
                <TextBlock Classes="eyebrow" Text="{Binding Header}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>

            <!-- App / process group -->
            <DataTemplate DataType="vm:ProcessGroup" x:DataType="vm:ProcessGroup">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <DockPanel Width="{ReflectionBinding NameWidth, Source={x:Static vm:ColumnLayout.Instance}}">
                  <Panel DockPanel.Dock="Left" Width="22" Margin="0,0,4,0">
                    <Button Classes="chevron" IsVisible="{Binding HasChildren}" Command="{Binding ToggleExpandedCommand}">
                      <TextBlock Classes="icon" FontSize="10" Text="{Binding Chevron}" />
                    </Button>
                  </Panel>
                  <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0"
                         VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
                  <TextBlock DockPanel.Dock="Right" Classes="label" Margin="6,0,0,0" VerticalAlignment="Center"
                             Text="{Binding CountText}" />
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <Panel Width="{ReflectionBinding StatusWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowStatus, Source={x:Static vm:ColumnLayout.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Classes="icon status-eco" FontSize="13" Text="&#xEC0A;" IsVisible="{Binding IsEfficient}" ToolTip.Tip="Efficiency mode" />
                    <TextBlock Classes="icon status-paused" FontSize="13" Text="&#xE769;" IsVisible="{Binding IsSuspended}" ToolTip.Tip="Suspended" />
                  </StackPanel>
                </Panel>
                <TextBlock Classes="label" TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding PidWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowPid, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding PidText}" />
                <TextBlock TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding CpuWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowCpu, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding CpuText}" />
                <TextBlock TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding GpuWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowGpu, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding GpuText}" />
                <TextBlock TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding MemWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowMem, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding MemoryText}" />
                <TextBlock TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding DiskWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowDisk, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding DiskText}" />
                <TextBlock TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding NetWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowNet, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding NetText}" />
              </StackPanel>
            </DataTemplate>

            <!-- Individual process inside an expanded group -->
            <DataTemplate DataType="vm:ProcessRow" x:DataType="vm:ProcessRow">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <DockPanel Width="{ReflectionBinding NameWidth, Source={x:Static vm:ColumnLayout.Instance}}">
                  <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="14" Height="14" Margin="54,0,8,0" Opacity="0.8"
                         VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
                  <TextBlock Classes="label" FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <Panel Width="{ReflectionBinding StatusWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowStatus, Source={x:Static vm:ColumnLayout.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Classes="icon status-eco" FontSize="13" Text="&#xEC0A;" IsVisible="{Binding IsEfficient}" ToolTip.Tip="Efficiency mode" />
                    <TextBlock Classes="icon status-paused" FontSize="13" Text="&#xE769;" IsVisible="{Binding IsSuspended}" ToolTip.Tip="Suspended" />
                  </StackPanel>
                </Panel>
                <TextBlock Classes="label" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding PidWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowPid, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding Pid}" />
                <TextBlock Classes="label" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding CpuWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowCpu, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding CpuText}" />
                <TextBlock Classes="label" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding GpuWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowGpu, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding GpuText}" />
                <TextBlock Classes="label" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding MemWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowMem, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding MemoryText}" />
                <TextBlock Classes="label" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding DiskWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowDisk, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding DiskText}" />
                <TextBlock Classes="label" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"
                           Width="{ReflectionBinding NetWidth, Source={x:Static vm:ColumnLayout.Instance}}" IsVisible="{ReflectionBinding ShowNet, Source={x:Static vm:ColumnLayout.Instance}}"
                           Text="{Binding NetText}" />
              </StackPanel>
            </DataTemplate>

          </ListBox.DataTemplates>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
