<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ember.ViewModels"
             x:Class="Ember.Views.ProcessesView"
             x:DataType="vm:ProcessesViewModel">

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Open file location" Command="{Binding OpenLocationCommand}" />
          <Button Content="End tree" Command="{Binding EndTreeCommand}" />
          <Button Classes="accent" Content="End task" Command="{Binding EndTaskCommand}" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Classes="h1" Text="Processes" />
          <TextBlock Classes="label" Text="{Binding Summary}" />
        </StackPanel>
      </DockPanel>
      <TextBox Watermark="Search by name or PID" Text="{Binding Search}" CornerRadius="10" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Classes="label" Margin="4,10,0,0"
               TextWrapping="Wrap" Text="{Binding Status}" />

    <Border Classes="card" Padding="0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,80,80,100" Margin="22,14,22,8">
          <Button Grid.Column="0" Classes="header" Content="{Binding NameHeader}"
                  Command="{Binding SortCommand}" CommandParameter="name" />
          <Button Grid.Column="1" Classes="header" Content="{Binding PidHeader}" HorizontalAlignment="Right"
                  Command="{Binding SortCommand}" CommandParameter="pid" />
          <Button Grid.Column="2" Classes="header" Content="{Binding CpuHeader}" HorizontalAlignment="Right"
                  Command="{Binding SortCommand}" CommandParameter="cpu" />
          <Button Grid.Column="3" Classes="header" Content="{Binding MemoryHeader}" HorizontalAlignment="Right"
                  Command="{Binding SortCommand}" CommandParameter="mem" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Stroke}" Margin="16,0" />

        <ListBox Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
          <ListBox.KeyBindings>
            <KeyBinding Gesture="Delete" Command="{Binding EndTaskCommand}" />
          </ListBox.KeyBindings>

          <ListBox.DataTemplates>

            <!-- Section header: "Apps (5)" -->
            <DataTemplate DataType="vm:SectionRow" x:DataType="vm:SectionRow">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,2">
                <TextBlock Classes="icon" FontSize="10" Foreground="{DynamicResource TextMuted}" Text="{Binding Chevron}" />
                <TextBlock Classes="eyebrow" Text="{Binding Header}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>

            <!-- App / process group -->
            <DataTemplate DataType="vm:ProcessGroup" x:DataType="vm:ProcessGroup">
              <Grid ColumnDefinitions="*,80,80,100">
                <DockPanel Grid.Column="0">
                  <Panel DockPanel.Dock="Left" Width="22" Margin="0,0,4,0">
                    <Button Classes="chevron" IsVisible="{Binding HasChildren}" Command="{Binding ToggleExpandedCommand}">
                      <TextBlock Classes="icon" FontSize="10" Text="{Binding Chevron}" />
                    </Button>
                  </Panel>
                  <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0"
                         VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
                  <TextBlock DockPanel.Dock="Right" Classes="label" Margin="6,0,8,0" VerticalAlignment="Center"
                             Text="{Binding CountText}" />
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Grid.Column="1" Classes="label" Text="{Binding PidText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>

            <!-- Individual process inside an expanded group -->
            <DataTemplate DataType="vm:ProcessRow" x:DataType="vm:ProcessRow">
              <Grid ColumnDefinitions="*,80,80,100">
                <DockPanel Grid.Column="0" Margin="54,0,0,0">
                  <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,8,0" Opacity="0.8"
                         VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
                  <TextBlock Classes="label" FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Grid.Column="1" Classes="label" Text="{Binding Pid}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="label" FontSize="13" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Classes="label" FontSize="13" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>

          </ListBox.DataTemplates>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
