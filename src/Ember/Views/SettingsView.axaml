<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ember.ViewModels"
             x:Class="Ember.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Classes="pageheader" Margin="0,0,0,12">
        <TextBlock Classes="h1" Text="Settings" />
        <TextBlock Classes="subtitle" Text="{Binding VersionText}" />
      </StackPanel>

      <!-- Appearance -->
      <TextBlock Classes="eyebrow" Text="APPEARANCE" Margin="4,0" />
      <Border Classes="card" Padding="20,2">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <ComboBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center"
                        ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedTheme}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Theme" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Switches instantly." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="ghost" Content="Open folder" Command="{Binding OpenThemesFolderCommand}" />
                <Button Classes="ghost" Content="Reload" Command="{Binding ReloadThemesCommand}" />
              </StackPanel>
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Custom themes" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Drop a JSON theme file in the themes folder, then reload." />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Monitoring -->
      <TextBlock Classes="eyebrow" Text="MONITORING" Margin="4,16,4,0" />
      <Border Classes="card" Padding="20,2">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <ComboBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center"
                        ItemsSource="{Binding RefreshOptions}" SelectedItem="{Binding SelectedRefresh}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Refresh rate" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Slower refresh uses even less CPU." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <ComboBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center"
                        ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding SelectedGpu}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Graphics card" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Which GPU the dashboard shows if you have more than one." />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Units -->
      <TextBlock Classes="eyebrow" Text="UNITS" Margin="4,16,4,0" />
      <Border Classes="card" Padding="20,2">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <ComboBox DockPanel.Dock="Right" Width="270" VerticalAlignment="Center"
                        ItemsSource="{Binding TemperatureUnits}" SelectedItem="{Binding SelectedTemperatureUnit}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Temperature" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Used everywhere, including alerts and fan curves." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <ComboBox DockPanel.Dock="Right" Width="270" VerticalAlignment="Center"
                        ItemsSource="{Binding MemoryUnits}" SelectedItem="{Binding SelectedMemoryUnit}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Process memory" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Memory column on the Processes page. Also on its header's right-click menu." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <ComboBox DockPanel.Dock="Right" Width="270" VerticalAlignment="Center"
                        ItemsSource="{Binding NetUnits}" SelectedItem="{Binding SelectedNetUnit}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Network speed" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Bits (Mbps) is how internet plans are sold; bytes (MB/s) is how downloads show." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <ComboBox DockPanel.Dock="Right" Width="270" VerticalAlignment="Center"
                        ItemsSource="{Binding DiskUnits}" SelectedItem="{Binding SelectedDiskUnit}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Disk speed" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Read and write speeds on the Storage page." />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Alerts -->
      <TextBlock Classes="eyebrow" Text="ALERTS" Margin="4,16,4,0" />
      <Border Classes="card" Padding="20,2">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" OnContent="" OffContent="" IsChecked="{Binding AlertsEnabled}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Temperature alerts" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap"
                           Text="A pop-up when the CPU or GPU stays above its limit for 10 seconds. Works while Ember is in the tray." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row" IsEnabled="{Binding AlertsEnabled}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Classes="stat" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding CpuAlertText}" />
              <Slider DockPanel.Dock="Right" Width="220" Minimum="60" Maximum="105" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding CpuAlert}" VerticalAlignment="Center" />
              <TextBlock Text="CPU limit" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Classes="row" IsEnabled="{Binding AlertsEnabled}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Classes="stat" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding GpuAlertText}" />
              <Slider DockPanel.Dock="Right" Width="220" Minimum="60" Maximum="105" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding GpuAlert}" VerticalAlignment="Center" />
              <TextBlock Text="GPU limit" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="ghost" Content="Send test alert" Command="{Binding SendTestAlertCommand}" />
              <TextBlock Classes="label" VerticalAlignment="Center" TextWrapping="Wrap"
                         Text="Modern CPUs can run up to 95–100°C under load by design; most GPUs are happiest below 85°C." />
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- History -->
      <TextBlock Classes="eyebrow" Text="HISTORY" Margin="4,16,4,0" />
      <Border Classes="card" Padding="20,2">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" OnContent="" OffContent="" IsChecked="{Binding HistoryToDisk}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Save history to disk" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap"
                           Text="Daily CSV logs you can open in Excel. Off keeps the last 24 hours in memory only." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row" IsEnabled="{Binding HistoryToDisk}">
            <DockPanel>
              <ComboBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center"
                        ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding SelectedRetention}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Keep logs for" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Older log files are deleted automatically. About 1 MB per day." />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Startup & tray -->
      <TextBlock Classes="eyebrow" Text="STARTUP &amp; TRAY" Margin="4,16,4,0" />
      <Border Classes="card" Padding="20,2">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" OnContent="" OffContent="" IsChecked="{Binding LaunchAtStartup}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Start Ember when I sign in" FontWeight="SemiBold" />
                <TextBlock Classes="label" Text="Opens quietly in the system tray." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row" IsEnabled="{Binding LaunchAtStartup}">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" OnContent="" OffContent="" IsChecked="{Binding StartupAsAdmin}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Start with admin rights" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap"
                           Text="CPU temps and fan control from boot, with no UAC prompt. Needs Ember running as admin once to turn on." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" OnContent="" OffContent="" IsChecked="{Binding MinimizeToTray}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Minimize to tray" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Hides Ember from the taskbar. Click the tray icon to bring it back." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" OnContent="" OffContent="" IsChecked="{Binding CloseToTray}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Close to tray" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="The close button keeps Ember running. Quit from the tray icon's menu." />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
      <TextBlock Classes="label" TextWrapping="Wrap" Margin="4,2,4,0" Text="{Binding StartupStatus}"
                 IsVisible="{Binding StartupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Updates -->
      <TextBlock Classes="eyebrow" Text="UPDATES" Margin="4,16,4,0" />
      <Border Classes="card" Padding="20,2">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" OnContent="" OffContent="" IsChecked="{Binding AutoCheckUpdates}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Check for updates on launch" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Downloads in the background. Nothing installs until you restart." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <StackPanel Spacing="10">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="ghost" Content="Check now" Command="{Binding CheckForUpdatesCommand}" />
                  <Button Classes="accent" Content="Restart and update" Command="{Binding InstallUpdateCommand}"
                          IsVisible="{Binding UpdateReady}" />
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,16,0">
                  <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                  <TextBlock Classes="label" TextWrapping="Wrap" Text="{Binding UpdateStatus}"
                             IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </DockPanel>
              <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" MinWidth="0" IsVisible="{Binding IsDownloading}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
