<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ember.ViewModels"
             x:Class="Ember.Views.StartupView"
             x:DataType="vm:StartupViewModel">

  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <Button DockPanel.Dock="Right" Classes="ghost" VerticalAlignment="Center" Command="{Binding RefreshCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon" FontSize="13" Text="&#xE72C;" />
          <TextBlock Text="Refresh" />
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Classes="h1" Text="Startup apps" />
        <TextBlock Classes="subtitle" Text="{Binding Status}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <ScrollViewer>
      <Border Classes="card" Padding="20,4" VerticalAlignment="Top">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StartupRow">
              <Border Classes="row">
                <DockPanel>
                  <ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                OnContent="" OffContent="" IsChecked="{Binding IsEnabled}" />
                  <Border DockPanel.Dock="Right" Classes="pill">
                    <TextBlock Classes="label" FontSize="11" Text="{Binding Location}" />
                  </Border>
                  <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,14,0"
                         VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
                  <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="label" Text="{Binding Command}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Command}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </ScrollViewer>
  </DockPanel>
</UserControl>
