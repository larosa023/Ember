<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ember.ViewModels"
             xmlns:c="using:Ember.Controls"
             x:Class="Ember.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <ScrollViewer>
    <StackPanel Spacing="22">

      <StackPanel Classes="pageheader" Margin="0">
        <TextBlock Classes="h1" Text="Dashboard" />
        <TextBlock Classes="subtitle" Text="{Binding UptimeText}" />
      </StackPanel>

      <Grid ColumnDefinitions="*,16,*,16,*">

        <!-- CPU -->
        <Button Grid.Column="0" Classes="tile" Command="{Binding OpenCommand}" CommandParameter="cpu"
                ToolTip.Tip="Details">
        <Border Classes="card">
          <StackPanel Spacing="18">
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="icon open" FontSize="12" Text="&#xE76C;" />
                <TextBlock Classes="eyebrow" Text="PROCESSOR" />
              </DockPanel>
              <TextBlock Classes="h2" Text="{Binding CpuName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Width="168" Height="168" HorizontalAlignment="Center">
              <c:RingGauge Value="{Binding CpuLoad}" StrokeThickness="13" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="big" HorizontalAlignment="Center" Text="{Binding CpuLoadText}" />
                <TextBlock Classes="label" HorizontalAlignment="Center" Text="usage" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*,*">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Classes="label" Text="Temp" />
                <TextBlock Classes="stat" Text="{Binding CpuTempText}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="label" Text="Clock" />
                <TextBlock Classes="stat" Text="{Binding CpuClockText}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Classes="label" Text="Power" />
                <TextBlock Classes="stat" Text="{Binding CpuPowerText}" />
              </StackPanel>
            </Grid>

            <c:Sparkline Height="52" Values="{Binding CpuHistoryValues}" />
          </StackPanel>
        </Border>
        </Button>

        <!-- GPU -->
        <Button Grid.Column="2" Classes="tile" Command="{Binding OpenCommand}" CommandParameter="gpu"
                ToolTip.Tip="Details">
        <Border Classes="card">
          <StackPanel Spacing="18">
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="icon open" FontSize="12" Text="&#xE76C;" />
                <TextBlock Classes="eyebrow" Text="GRAPHICS" />
              </DockPanel>
              <TextBlock Classes="h2" Text="{Binding GpuName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Width="168" Height="168" HorizontalAlignment="Center">
              <c:RingGauge Value="{Binding GpuLoad}" StrokeThickness="13" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="big" HorizontalAlignment="Center" Text="{Binding GpuLoadText}" />
                <TextBlock Classes="label" HorizontalAlignment="Center" Text="usage" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*,*">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Classes="label" Text="Temp" />
                <TextBlock Classes="stat" Text="{Binding GpuTempText}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="label" Text="Clock" />
                <TextBlock Classes="stat" Text="{Binding GpuClockText}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Classes="label" Text="VRAM" />
                <TextBlock Classes="stat" Text="{Binding VramText}" />
              </StackPanel>
            </Grid>

            <c:Sparkline Height="52" Values="{Binding GpuHistoryValues}" />
          </StackPanel>
        </Border>
        </Button>

        <!-- Memory -->
        <Button Grid.Column="4" Classes="tile" Command="{Binding OpenCommand}" CommandParameter="ram"
                ToolTip.Tip="Details">
        <Border Classes="card">
          <StackPanel Spacing="18">
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="icon open" FontSize="12" Text="&#xE76C;" />
                <TextBlock Classes="eyebrow" Text="MEMORY" />
              </DockPanel>
              <TextBlock Classes="h2" Text="{Binding RamTotalText, StringFormat='{}{0} installed'}" />
            </StackPanel>

            <Grid Width="168" Height="168" HorizontalAlignment="Center">
              <c:RingGauge Value="{Binding RamLoad}" StrokeThickness="13" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="big" HorizontalAlignment="Center" Text="{Binding RamLoadText}" />
                <TextBlock Classes="label" HorizontalAlignment="Center" Text="in use" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*,*">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Classes="label" Text="Used" />
                <TextBlock Classes="stat" Text="{Binding RamUsedText}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="label" Text="Free" />
                <TextBlock Classes="stat" Text="{Binding RamFreeText}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Classes="label" Text="Total" />
                <TextBlock Classes="stat" Text="{Binding RamTotalText}" />
              </StackPanel>
            </Grid>

            <c:Sparkline Height="52" Values="{Binding RamHistoryValues}" />
          </StackPanel>
        </Border>
        </Button>
      </Grid>

      <!-- Storage + Network -->
      <Grid ColumnDefinitions="*,16,*" Margin="0,-6,0,0">
        <Button Grid.Column="0" Classes="tile" Command="{Binding OpenCommand}" CommandParameter="storage" ToolTip.Tip="Details">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Classes="icon open" FontSize="12" Text="&#xE76C;" />
                  <TextBlock Classes="eyebrow" Text="STORAGE" />
                </DockPanel>
                <TextBlock Classes="label" Text="{Binding StorageSummary}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Volumes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:VolumeRow">
                    <StackPanel Spacing="5">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Classes="label" Text="{Binding UsedText}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" />
                          <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DockPanel>
                      <c:UsageBar Height="6" Value="{Binding Percent}" Classes.full="{Binding IsNearlyFull}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Button>

        <Button Grid.Column="2" Classes="tile" Command="{Binding OpenCommand}" CommandParameter="network" ToolTip.Tip="Details">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Classes="icon open" FontSize="12" Text="&#xE76C;" />
                  <TextBlock Classes="eyebrow" Text="NETWORK" />
                </DockPanel>
                <TextBlock Classes="label" Text="{Binding NetName}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Classes="label" Text="Download" />
                  </StackPanel>
                  <TextBlock Classes="stat" FontSize="18" Text="{Binding NetDownText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Series2}" VerticalAlignment="Center" />
                    <TextBlock Classes="label" Text="Upload" />
                  </StackPanel>
                  <TextBlock Classes="stat" FontSize="18" Text="{Binding NetUpText}" />
                </StackPanel>
              </Grid>
              <c:Sparkline Height="52" Values="{Binding NetDownHistory}" Values2="{Binding NetUpHistory}" Maximum="{Binding NetMax}" />
            </StackPanel>
          </Border>
        </Button>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
