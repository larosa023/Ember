<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ember.ViewModels"
             xmlns:c="using:Ember.Controls"
             x:Class="Ember.Views.DetailView"
             x:DataType="vm:DetailViewModel">

  <ScrollViewer>
    <StackPanel Spacing="18">

      <Button Classes="ghost" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="-10,-6,0,-4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon" FontSize="12" Text="&#xE72B;" />
          <TextBlock Text="Dashboard" />
        </StackPanel>
      </Button>

      <!-- Big graph -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
              <TextBlock Classes="big" HorizontalAlignment="Right" Text="{Binding Headline}" />
              <TextBlock Classes="label" HorizontalAlignment="Right" Text="{Binding GraphLabel}" />
            </StackPanel>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Classes="eyebrow" Text="{Binding Title}" />
              <TextBlock Classes="h1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
          <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="0,8,0,0" ClipToBounds="True">
            <c:Sparkline Height="190" Values="{Binding History}" />
          </Border>
        </StackPanel>
      </Border>

      <!-- Key stats -->
      <ItemsControl ItemsSource="{Binding Stats}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="12" LineSpacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StatTile">
            <Border Classes="card" Width="186" Padding="16,14">
              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="stat" FontSize="18" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- GPU power limit (NVIDIA only) -->
      <Border Classes="card" IsVisible="{Binding Tuning.IsAvailable, FallbackValue=False}">
        <StackPanel Spacing="12" DataContext="{Binding Tuning}" x:DataType="vm:GpuTuningViewModel">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="label" Text="{Binding CurrentText}" VerticalAlignment="Center" />
            <TextBlock Classes="eyebrow" Text="POWER LIMIT" />
          </DockPanel>
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="Lower it to cut heat, noise and power draw for a small loss in speed (80% usually costs only a few % of FPS). Raise it for a little more performance if your card allows. The driver keeps it within safe limits, and Ember restores the default when it closes." />
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Width="110" TextAlignment="Right"
                       VerticalAlignment="Center" Text="{Binding TargetText}" />
            <Slider Minimum="{Binding MinPercent}" Maximum="{Binding MaxPercent}" Value="{Binding Percent}"
                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Classes="label" Text="{Binding RangeText}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="Apply" Command="{Binding ApplyCommand}" />
            <Button Content="Reset to default" Command="{Binding ResetCommand}" />
          </StackPanel>
          <TextBlock Classes="label" TextWrapping="Wrap" IsVisible="{Binding !IsElevated}"
                     Text="Changing the power limit needs admin: use &quot;Restart as admin&quot; in the sidebar, or turn on &quot;Start with admin rights&quot; in Settings." />
          <TextBlock Classes="label" TextWrapping="Wrap" Text="{Binding Status}"
                     IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- Clear standby memory (Memory only) -->
      <Border Classes="card" IsVisible="{Binding Cleanup, Converter={x:Static ObjectConverters.IsNotNull}}">
        <DockPanel DataContext="{Binding Cleanup}" x:DataType="vm:MemoryCleanupViewModel">
          <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Clear standby memory"
                  IsEnabled="{Binding !IsBusy}" Command="{Binding ClearCommand}" />
          <StackPanel Spacing="6" Margin="0,0,16,0">
            <TextBlock Classes="eyebrow" Text="FREE UP MEMORY" />
            <TextBlock Classes="label" TextWrapping="Wrap"
                       Text="Drops the cache Windows keeps of recently used files. Safe to do anytime; it can smooth out stutters in games when RAM is nearly full. Needs admin." />
            <TextBlock Classes="label" Text="{Binding StandbyText}"
                       IsVisible="{Binding StandbyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock TextWrapping="Wrap" Text="{Binding Status}"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Per-core (CPU only) -->
      <Border Classes="card" IsVisible="{Binding ShowCores}">
        <StackPanel Spacing="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="label" Text="{Binding CoresSummary}" VerticalAlignment="Center" />
            <TextBlock Classes="eyebrow" Text="CORES" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Cores}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="10" LineSpacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CoreTile">
                <Border Width="128" Padding="12,10" CornerRadius="10" Background="{DynamicResource SurfaceAlt}">
                  <StackPanel Spacing="6">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding LoadText}" />
                      <TextBlock Classes="label" Text="{Binding Name}" />
                    </DockPanel>
                    <c:UsageBar Height="6" HorizontalAlignment="Stretch" Value="{Binding Load}" />
                    <TextBlock Classes="label" FontSize="11" Text="{Binding ClockText}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Every sensor for this part, grouped by type -->
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="16" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SensorGroup">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,110,110,110">
                  <TextBlock Grid.Column="0" Classes="eyebrow" Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Classes="eyebrow" Text="NOW" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Classes="eyebrow" Text="MIN" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Classes="eyebrow" Text="MAX" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SensorRow">
                      <Grid ColumnDefinitions="*,110,110,110" Margin="0,4">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Classes="label" Text="{Binding Min}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Classes="label" Text="{Binding Max}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
