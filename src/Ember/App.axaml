<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Ember"
             x:Class="Ember.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Ember/Styles/Ember.axaml" />
  </Application.Styles>

  <!-- Theme brushes (Bg, Surface, Accent, ...) are injected at runtime by ThemeService. -->
</Application>
